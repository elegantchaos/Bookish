{
  "format": { "id": "com.elegantchaos.bookish.records", "version": 1 },
  "schema": { "defaultKind": "layout" },
  "records": [
    { "ℹ": "datastore-all-fields-layout", "name": "All Fields", "types": ["*"], "fields": ["*"] },
    { "ℹ": "datastore-book-layout", "name": "Book", "types": ["book"], "fields": ["@datastore-book-relationships-layout", "@datastore-book-publication-layout", "@datastore-book-identifiers-layout", "@datastore-book-physical-layout", "@datastore-book-library-layout", "@datastore-book-media-layout"] },
    { "ℹ": "datastore-book-relationships-layout", "name": "Contributors & Relationships", "types": ["book"], "isSection": true, "fields": ["authors", "illustrators", "series", "seriesPosition", "publishers"] },
    { "ℹ": "datastore-book-publication-layout", "name": "Publication & Classification", "types": ["book"], "isSection": true, "fields": ["published", "format", "genres", "editions", "dewey"] },
    { "ℹ": "datastore-book-identifiers-layout", "name": "Identifiers", "types": ["book"], "isSection": true, "fields": ["isbn", "asin"] },
    { "ℹ": "datastore-book-physical-layout", "name": "Physical Details", "types": ["book"], "isSection": true, "fields": ["pages", "height", "width", "length"] },
    { "ℹ": "datastore-book-library-layout", "name": "Library Details", "types": ["book"], "isSection": true, "fields": ["status", "added", "modified", "note"] },
    { "ℹ": "datastore-book-media-layout", "name": "Media", "types": ["book"], "isSection": true, "fields": ["imageURLs"] },
    { "ℹ": "datastore-person-layout", "name": "Person", "types": ["person"], "fields": ["name", "@query-section-person-books", "source", "*"] },
    { "ℹ": "datastore-organisation-layout", "name": "Organisation", "types": ["organisation"], "fields": ["name", "@query-section-publisher-books", "source", "*"] },
    { "ℹ": "datastore-series-layout", "name": "Series", "types": ["series"], "fields": ["name", "@query-section-series-books", "source", "*"] },
    { "ℹ": "datastore-list-layout", "name": "List", "types": ["list"], "fields": ["name", "items", "source", "*"] },
    { "ℹ": "datastore-layout-layout", "name": "Layout", "types": ["layout"], "fields": ["name", "types", "fields", "excludedFields", "presentation", "*"] },
    { "ℹ": "datastore-index-layout", "name": "Index", "types": ["index"], "fields": ["name", "position", "debugOnly", "layout", "types", "query", "*"] }
  ]
}
