  <item id="212" isbn="1857230760" title="The Eye of the World (Wheel of Time S.)" publisher="Orbit" publication="1992" pages="8.32E2" added="2004-11-28" acquisition="2004-11-28" format="Paperback" read="0" favourite="0" purchaseprice="£7.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
