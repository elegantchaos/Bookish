  <item id="578" isbn="0099307308" title="Grave Secrets" publisher="Arrow" publication="2003" pages="4E2" added="2007-05-06" acquisition="2007-05-06" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
