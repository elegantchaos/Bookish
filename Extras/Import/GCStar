  <item id="73" isbn="0091874564" title="Playing the Moldovans at Tennis" publisher="Ebury Press" publication="2001" pages="2.48E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£7.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
    <authors>
