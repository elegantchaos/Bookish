  <item id="463" isbn="0751533254" title="A Big Boy Did It and Ran Away" publisher="Time Warner Paperbacks" publication="2002" pages="5.12E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
