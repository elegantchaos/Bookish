  <item id="1057" isbn="1857988221" title="The Demolished Man (Millennium SF Masterworks S)" publisher="Gollancz" publication="1999" pages="2.56E2" added="2004-11-28" acquisition="2004-11-28" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
