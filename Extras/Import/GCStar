  <item id="721" isbn="0553505815" title="The Chosen (Stone Dance of the Chameleon)" publisher="Bantam" publication="2000" pages="7.18E2" added="2004-11-26" acquisition="2004-11-26" format="Paperback" read="0" favourite="0" purchaseprice="£7.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
