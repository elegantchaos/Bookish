  <item id="502" isbn="0596000464" title="Learning XML" publisher="O'Reilly UK" publication="2001" pages="3.5E2" added="2004-12-01" acquisition="2004-12-01" format="Paperback" read="0" favourite="0" purchaseprice="£24.95" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
