  <item id="1161" isbn="0224041185" title="Filth" publisher="Jonathan Cape" publication="1998" pages="4E2" added="2006-12-20" acquisition="2006-12-20" format="Paperback" read="0" favourite="0" purchaseprice="£9.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
