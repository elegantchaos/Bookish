  <item id="421" isbn="0140307893" title="The Children of Green Knowe (Puffin Books)" publisher="Puffin Books" publication="1975" pages="1.6E2" added="2004-12-04" acquisition="2004-12-04" format="Paperback" read="0" favourite="0" purchaseprice="£4.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
