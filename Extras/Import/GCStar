  <item id="795" isbn="0752224700" title="The Dilbert Principle" publisher="Boxtree" publication="1997" pages="3.52E2" added="2006-12-20" acquisition="2006-12-20" format="Paperback" read="0" favourite="0" purchaseprice="£7.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
