  <item id="1207" isbn="0671021907" title="The Amber Citadel" publisher="Simon &amp; Schuster (Trade Division)" publication="1999" pages="5.99E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£5.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
