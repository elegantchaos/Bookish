  <item id="1002" isbn="0747594481" title="The Gum Thief Special Edition" publisher="Bloomsbury Publishing PLC" publication="2007" added="2008-09-06" acquisition="2008-09-06" format="Hardback" read="0" favourite="0" purchaseprice="£26.00" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
