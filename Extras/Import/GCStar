  <item id="574" isbn="0122290631" title="3D Game Engine Design" publisher="Morgan Kaufmann" publication="2006" pages="1.04E3" added="2008-03-17" acquisition="2008-03-17" format="Hardback" read="0" favourite="0" purchaseprice="£39.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
