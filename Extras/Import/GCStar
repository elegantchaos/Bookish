  <item id="739" isbn="0671021931" title="Sailing to Sarantium" publisher="Earthlight" publication="1999" pages="4.37E2" added="2004-11-28" acquisition="2004-11-28" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
