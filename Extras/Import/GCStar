  <item id="9" isbn="0670894427" title="Little Green Man" publisher="Viking" publication="2001" pages="2.56E2" added="2004-11-28" acquisition="2004-11-28" format="Hardback" read="0" favourite="0" purchaseprice="£12.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
