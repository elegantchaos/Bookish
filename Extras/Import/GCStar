  <item id="1008" isbn="0380973464" title="Cryptonomicon" publisher="Avon Books" publication="1999" pages="9.28E2" added="2016-02-02" acquisition="2016-02-02" format="Hardback" read="0" favourite="0" purchaseprice="£18.94" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
