  <item id="825" isbn="0140306013" title="Watership Down (Puffin Books)" publisher="Puffin Books" publication="1973" pages="4.8E2" added="2004-11-26" acquisition="2004-11-26" format="Paperback" read="0" favourite="0" purchaseprice="£5.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
