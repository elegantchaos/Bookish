  <item id="4" isbn="1857236920" title="The Tower of the King's Daughter (Outremer)" publisher="Orbit" publication="1998" pages="6E2" added="2004-11-26" acquisition="2004-11-26" format="Paperback" read="0" favourite="0" purchaseprice="£7.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
