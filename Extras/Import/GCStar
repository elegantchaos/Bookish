  <item id="791" isbn="0552997021" title="A Walk in the Woods" publisher="Black Swan" publication="1998" pages="3.5E2" added="2004-11-28" acquisition="2004-11-28" format="Paperback" read="0" favourite="0" purchaseprice="£7.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
