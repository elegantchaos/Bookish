  <item id="224" isbn="0571166075" title="Kid" publisher="Faber and Faber Ltd" publication="2002" pages="9.6E1" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£8.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
