  <item id="160" isbn="0571229182" title="The Lighthouse" publisher="Faber and Faber" publication="2005" pages="4E2" added="2005-11-28" acquisition="2005-11-28" format="Hardback" read="0" favourite="0" purchaseprice="£17.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
