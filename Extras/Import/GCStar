  <item id="608" isbn="0743408934" title="Talisker (The Last Clansman)" publisher="Earthlight" publication="2001" pages="3.84E2" added="2006-12-20" acquisition="2006-12-20" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
