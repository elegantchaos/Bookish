  <item id="1256" isbn="0552146153" title="Carpe Jugulum (Discworld Novel)" publisher="Corgi Adult" publication="1999" pages="4.24E2" added="2007-05-06" acquisition="2007-05-06" format="Paperback" read="0" favourite="0" purchaseprice="£7.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
