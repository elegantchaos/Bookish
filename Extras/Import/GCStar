  <item id="460" isbn="0140281061" title="Beneath the Skin" publisher="Penguin Books Ltd" publication="2001" pages="3.84E2" added="2005-05-07" acquisition="2005-05-07" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
