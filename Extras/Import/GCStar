  <item id="53" isbn="1841492035" title="Engine City (Engines of Light S.)" publisher="Orbit" publication="2003" pages="3.84E2" added="2004-11-28" acquisition="2004-11-28" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
