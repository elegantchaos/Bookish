  <item id="1192" isbn="0743409116" title="Things Unborn" publisher="Earthlight" publication="2001" pages="3.68E2" added="2004-11-28" acquisition="2004-11-28" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
