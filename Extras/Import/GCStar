  <item id="1277" isbn="0330369954" title="Underworld" publisher="Picador" publication="1998" pages="8.32E2" added="2006-04-01" acquisition="2006-04-01" format="Paperback" read="0" favourite="0" purchaseprice="£10.00" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
