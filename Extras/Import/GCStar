  <item id="1231" isbn="0586037721" title="The Gods Themselves" publisher="Grafton Books" publication="1973" pages="2.56E2" added="2004-11-26" acquisition="2004-11-26" format="Paperback" read="0" favourite="0" purchaseprice="£3.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
