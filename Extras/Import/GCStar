  <item id="151" isbn="1857239679" title="The Sky Road" publisher="Orbit" publication="2000" pages="3.04E2" added="2004-11-28" acquisition="2004-11-28" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
