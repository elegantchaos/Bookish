  <item id="70" isbn="1565921674" title="Linux in a Nutshell" publisher="O'Reilly UK" publication="1996" pages="4.38E2" added="2004-12-01" acquisition="2004-12-01" format="Paperback" read="0" favourite="0" purchaseprice="£14.95" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
