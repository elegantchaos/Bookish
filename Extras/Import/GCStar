  <item id="262" isbn="0752847961" title="Bitterroot" publisher="Orion mass market paperback" publication="2002" pages="3.84E2" added="2004-11-26" acquisition="2004-11-26" format="Paperback" read="0" favourite="0" purchaseprice="£5.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
