  <item id="1151" isbn="0006512879" title="Arms and the Women" publisher="HarperCollins" publication="2003" pages="4.96E2" added="2005-07-10" acquisition="2005-07-10" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
