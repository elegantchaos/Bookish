  <item id="833" isbn="0708883095" title="The Player of Games (Orbit Books)" publisher="Orbit" publication="1991" pages="3.2E2" added="2004-11-26" acquisition="2004-11-26" format="Paperback" read="0" favourite="0" purchaseprice="£5.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
