  <item id="1316" isbn="0006514812" title="One for My Baby" publisher="HarperCollins" publication="2002" pages="4E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
