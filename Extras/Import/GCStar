  <item id="451" isbn="0752844059" title="The Falls (Inspector Rebus S.)" publisher="Orion mass market paperback" publication="2001" pages="4.96E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
