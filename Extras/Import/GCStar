  <item id="193" isbn="000649997X" title="One of Us" publisher="HarperCollins" publication="1999" pages="3.68E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
