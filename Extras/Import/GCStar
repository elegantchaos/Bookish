  <item id="443" isbn="0743408268" title="The Sapphire Throne (The Jewelfire Trilogy)" publisher="Earthlight" publication="2000" pages="4.32E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
