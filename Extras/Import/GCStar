  <item id="744" isbn="1843431130" title="Before the Frost (Linda Wallander Mystery S.)" publisher="The Harvill Press" publication="2004" pages="3.88E2" added="2004-11-27" acquisition="2004-11-27" format="Hardback" read="0" favourite="0" purchaseprice="£14.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
