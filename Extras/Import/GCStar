  <item id="812" isbn="1857988647" title="Teranesia" publisher="Gollancz" publication="2000" pages="2.56E2" added="2004-11-28" acquisition="2004-11-28" format="Paperback" read="0" favourite="0" purchaseprice="£5.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
