  <item id="109" isbn="0575076526" title="Woken Furies (Gollancz)" publisher="Gollancz" publication="2005" pages="5.76E2" added="2008-03-17" acquisition="2008-03-17" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
