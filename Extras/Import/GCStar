  <item id="382" isbn="0751530778" title="Trace" publisher="Time Warner Paperbacks" publication="2005" pages="4.96E2" added="2006-12-20" acquisition="2006-12-20" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
