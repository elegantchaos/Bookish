  <item id="1330" isbn="0751533599" title="Portrait of a Killer" publisher="Time Warner Paperbacks" publication="2003" pages="4.96E2" added="2005-07-10" acquisition="2005-07-10" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
