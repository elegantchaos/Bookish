  <item id="551" isbn="0201310058" title="Effective Java (Java S.)" publisher="Addison Wesley" publication="2001" pages="2.63E2" added="2005-05-07" acquisition="2005-05-07" format="Paperback" read="0" favourite="0" purchaseprice="£30.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
