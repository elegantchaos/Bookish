  <item id="203" isbn="0141014598" title="Blink" publisher="Penguin Books Ltd" publication="2006" pages="2.88E2" added="2006-12-20" acquisition="2006-12-20" format="Paperback" read="0" favourite="0" purchaseprice="£8.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
