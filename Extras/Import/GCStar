  <item id="694" isbn="B00486U6VU" title="Dreamer's Cat" publisher="Three Elephants" publication="2010" pages="2.01E2" added="2014-12-06" acquisition="2014-12-06" read="0" favourite="0" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
    <authors>
      <line>
        <col>Stephen Leather</col>
      </line>
    </authors>
