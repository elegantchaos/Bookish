  <item id="734" isbn="0575070986" title="Orbitsville (Gollancz SF Collector's Edition)" publisher="Gollancz" publication="2000" pages="1.87E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£9.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
