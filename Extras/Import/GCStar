  <item id="196" isbn="0349114676" title="A Big Boy Did It and Ran Away" publisher="Abacus" publication="2001" language="English" pages="3.2E2" added="2006-12-20" acquisition="2006-12-20" format="Paperback" read="0" favourite="0" purchaseprice="£9.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
