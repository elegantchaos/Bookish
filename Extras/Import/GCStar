  <item id="1271" isbn="0747550999" title="Harry Potter and the Goblet of Fire" publisher="Bloomsbury" publication="2001" pages="6.36E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
