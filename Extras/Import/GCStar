  <item id="58" isbn="0099272687" title="A Patchwork Planet" publisher="Vintage" publication="1999" pages="3.04E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
