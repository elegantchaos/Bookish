  <item id="934" isbn="0752817116" title="The Hanging Garden (Inspector Rebus S.)" publisher="Orion mass market paperback" publication="1999" pages="4.48E2" added="2004-12-29" acquisition="2004-12-29" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
