  <item id="439" isbn="014028107X" title="The Red Room" publisher="Penguin Books Ltd" publication="2002" pages="4.48E2" added="2006-12-20" acquisition="2006-12-20" format="Paperback" read="0" favourite="0" purchaseprice="£6.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
