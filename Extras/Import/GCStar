  <item id="905" isbn="0701177349" title="The Amateur Marriage" publisher="Chatto and Windus" publication="2004" pages="3.2E2" added="2005-11-28" acquisition="2005-11-28" format="Hardback" read="0" favourite="0" purchaseprice="£16.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
