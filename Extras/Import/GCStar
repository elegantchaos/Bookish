  <item id="248" isbn="0330392891" title="Perdido Street Station" publisher="Tor Books" publication="2001" pages="8.8E2" added="2004-11-29" acquisition="2004-11-29" format="Paperback" read="0" favourite="0" purchaseprice="£7.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
