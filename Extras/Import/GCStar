  <item id="24" isbn="0330438301" title="The Turning" publisher="Picador" publication="2005" pages="2E2" added="2005-05-25" acquisition="2005-05-25" format="Hardback" read="0" favourite="0" purchaseprice="£16.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
