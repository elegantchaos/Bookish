  <item id="1111" isbn="0006551610" title="Millennium People" publisher="HarperPerennial" publication="2003" pages="3.04E2" added="2006-12-20" acquisition="2006-12-20" format="Paperback" read="0" favourite="0" purchaseprice="£7.99" gift="0" signing="0" cover="/home/sam/.local/sharegcstar/images/">
