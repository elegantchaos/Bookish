    {
      "id": "HGmpZEr633uR1Vgl1LKYt",
      "type": "text",
      "x": 100,
      "y": 860,
      "width": 881.6507999999992,
      "height": 90,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
