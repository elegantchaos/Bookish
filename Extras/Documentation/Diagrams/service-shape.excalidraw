    {
      "id": "F2u8PBoOG5TQTv9HXGACz",
      "type": "text",
      "x": 92,
      "y": 821.3333333333334,
      "width": 881.6507999999992,
      "height": 90,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 1992901883,
      "version": 3,
      "versionNonce": 416511903,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790337967324,
      "created": 1790337967324,
      "link": null,
      "locked": false,
      "text": "Views receive only State projections and the commander; never a service, its API, or the engine.\nCommands see only the API vended through the smallest Access they need.\nState, API and Access are nested in a same-file extension after the service's primary definition.\nA service without view-facing state has no State; one without command operations has no API or Access.",
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Views receive only State projections and the commander; never a service, its API, or the engine.\nCommands see only the API vended through the smallest Access they need.\nState, API and Access are nested in a same-file extension after the service's primary definition.\nA service without view-facing state has no State; one without command operations has no API or Access.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
